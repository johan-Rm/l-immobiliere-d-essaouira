{% if item.primaryImage is not null %}
	{% set webpFilename = item.primaryImage.filename|split('.')|first ~ ".webp" %}
	<a href="#" class="easyadmin-thumbnail" data-featherlight="#easyadmin-lightbox-{{ item.primaryImage.id }}" data-featherlight-close-on-click="anywhere">
	    {# the second parameter is the name of the property with the UploadableField annotation #}
	    <picture>
		     <source srcset="{{ asset(webpFilename, 'medias_grid_nostamp_small') }}" type="image/webp" />
		     <source srcset="{{ asset(item.primaryImage.filename, 'medias_grid_nostamp_small') }}" type="image/jpeg" />
		     <img src="{{ asset(item.primaryImage.filename, 'medias_grid_nostamp_small') }}">
		</picture>
	</a>

	<div id="easyadmin-lightbox-{{ item.primaryImage.id }}" class="easyadmin-lightbox">
	    {# the second parameter is the name of the property with the UploadableField annotation #}
	    
	    <picture>
		     <source srcset="{{ asset(webpFilename, 'medias_large_nostamp') }}" type="image/webp" />
		     <source srcset="{{ asset(item.primaryImage.filename, 'medias_large_nostamp') }}" type="image/jpeg" />
		     <img src="{{ asset(item.primaryImage.filename, 'medias_large_nostamp') }}">
		</picture>
	</div>
{% else %}
    <span class="label">Aucun(e)</span>
{% endif %}