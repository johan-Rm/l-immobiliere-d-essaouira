<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="utf-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="robots" content="noindex, nofollow, noarchive, nosnippet, noodp, noimageindex, notranslate, nocache" />
    <meta content="width=device-width, initial-scale=1, maximum-scale=1, user-scalable=no" name="viewport">
    <meta name="generator" content="EasyAdmin" />
    <meta name="google-signin-scope" content="profile email">
    <meta name="google-signin-client_id" content="953423502628-mlj0q31mf082asvpka7fja1crcj8ebcl.apps.googleusercontent.com">
	<link href="https://fonts.googleapis.com/css?family=Poppins:300,400,500,600,700" rel="stylesheet">

</head>
<body style="margin: 0 auto;padding: 0;height: 100%;width: 100%; mso-line-height-rule: exactly;background-color: #f1f1f1;color: #000;font-family: Poppins, Arial">
   <center style="width: 100%;background-color: #282828;color: #000">
      <div style="max-width: 600px; margin: 0 auto;background-color: #fff">
         <table align="center" role="presentation" cellspacing="0" cellpadding="0" border="0" width="100%" style="margin: auto;">
            <tr>
               <td valign="top" style="background-color: #222D52">
                  <table role="presentation" border="0" cellpadding="0" cellspacing="0" width="100%">
                     <tr>
                        <td width="100%" class="logo" style="text-align: left;padding: 20px 30px;">
                           <nav class="navbar" role="navigation" style="background-color: #222D52;padding: 20px 30px;border-radius: 0;border: 0">
                              <div id="header-logo"> <img width="220" src="{{logo}}"> </div>
                           </nav>
                        </td>
                     </tr>
                  </table>
               </td>
            </tr>
            <tr>
               <td class="bg_white">
                  <table role="presentation" cellspacing="0" cellpadding="0" border="0" width="100%">
                     <tr>
                        <td class="bg_white email-section">
                           <div class="heading-section" style="text-align: center; padding: 0 30px;">
                              <h1 style="text-transform: uppercase;padding: 0 20px;font-size: 1.5em">Nouvelle demande de contact</h1>
                              <p>Message reçu de la part de <b>{{lastname}}{{firstname}}</b></p>
                              <p class="mail"><b>{{email}}</b></p>
                              <p class="mail"><b>{{phone}}</b></p>
                              {% if reference is not empty %}
                              <p>Référence : {{ reference }}</p>
                              {% endif %}
                              <div style="margin-top: 50px;margin-bottom: 50px">
                                 <p style="text-align: left;font-weight: 500;color: #282828">Message : </p>
                                 <blockquote style="color: rgba(0, 0, 0, .6);border-left: 3px solid #282828;line-height: 1.8">{{message}}</blockquote>
                              </div>
                           </div>
                        </td>
                     </tr>
                  </table>
               </td>
            </tr>
         </table>
         <table align="center" role="presentation" cellspacing="0" cellpadding="0" border="0" width="100%" style="margin: auto;">
            <tr>
               <td valign="middle" style="padding:1.5em;background-color: #222D52">
                  <table>
                     <tr>
                        <td valign="top" width="100%">
                           <table role="presentation" cellspacing="0" cellpadding="0" border="0" width="100%">
                              <tr>
                                 <td style="text-align: left; padding-right: 10px;">
                                    <p style="color: #fff">&copy; {{ date }} L'Immoblière d'Essaouira conçu par <a href="mailto:johan.remy@graines-digitales.online" style="color: #282828;text-decoration: none;">Graines Digitales</a>.</p>
                                 </td>
                              </tr>
                           </table>
                        </td>
                     </tr>
                  </table>
               </td>
            </tr>
         </table>
      </div>
   </center>
</body>
</html>
